# Copy to .env for local scripts (never commit it).
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Provider chain: primary first, then fallbacks on 429 / 503 / exhausted credits.
LLM_PROVIDER=sarvam
LLM_FALLBACKS=gemini,groq

# Sarvam (primary) — https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Google Gemini (fallback 1) — https://aistudio.google.com/apikey
# Also used to describe images for the AI (D58)
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq (fallback 2) — https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults shown). The smoke test reports 404 if a model id isn't available to your key.
# SARVAM_MODEL=sarvam-105b
# SARVAM_STREAM=false          # true = token streaming (Sarvam's streamed tool calls currently fail to parse)
# SARVAM_REASONING=low          # none | low | medium | high (reasoning tokens count against max_tokens)
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b

# Stock photos for AI-placed images need no key: Wikimedia Commons, asked anonymously (D57, D79).
